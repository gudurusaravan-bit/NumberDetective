name: Build Number Detective APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: '8.9'

      - uses: android-actions/setup-android@v4
        with:
          packages: 'platforms;android-35 build-tools;35.0.0'

      - name: Unpack project
        run: unzip -q NumberDetective-Android-Project.zip -d build-source

      - name: Build APK
        run: gradle -p build-source/NumberDetective assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NumberDetective-APK
          path: build-source/NumberDetective/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
